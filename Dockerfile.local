# Image de test LAN / Tailscale — NE REMPLACE PAS le Dockerfile de dev.
# Sert à jouer depuis un téléphone ou une tablette sur le réseau local,
# ou à distance via Tailscale.
#
# Différences avec ./Dockerfile :
#   - Node 22 (Angular 21.2 refuse Node 18)
#   - vrai build de production (`npm run build --configuration=x` fait avaler
#     l'option par npm et produit un build de dev)
#   - conf nginx avec fallback SPA
#   - endpoint Appwrite injecté au runtime via env.js, donc une seule image
#     sert le LAN et Tailscale

FROM node:22-alpine AS build
WORKDIR /app

# husky ne peut pas s'installer sans dépôt git dans l'image
ENV HUSKY=0

COPY package*.json ./
RUN npm ci --legacy-peer-deps

COPY . .
RUN npx ng build --configuration production

FROM nginx:alpine
# openssl n'est pas dans nginx:alpine et sert au certificat auto-signe
RUN apk add --no-cache openssl

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
# Corps partage entre les ecouteurs 80 et 443. Volontairement HORS de conf.d/ :
# nginx.conf inclut conf.d/*.conf automatiquement, et ce fichier n'a pas de bloc
# server — charge seul, ses `location` feraient echouer le demarrage.
COPY docker/nginx-app.conf /etc/nginx/app-common.conf

# Certificat auto-signe puis env.js, dans cet ordre (30 avant 40)
COPY docker/30-selfsigned-cert.sh /docker-entrypoint.d/30-selfsigned-cert.sh
COPY docker/40-appwrite-env.sh /docker-entrypoint.d/40-appwrite-env.sh
RUN chmod +x /docker-entrypoint.d/30-selfsigned-cert.sh /docker-entrypoint.d/40-appwrite-env.sh
# outputPath = dist/ketal (builder :browser, fichiers à plat)
COPY --from=build /app/dist/ketal/ /usr/share/nginx/html/
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
